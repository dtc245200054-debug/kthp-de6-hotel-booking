      "title": "Trạng Thái Hoạt Động Các Targets (Prometheus Scrape Targets)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "up",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "DOWN (Lỗi)",
                  "color": "red"
                },
                "1": {
                  "text": "UP (Khỏe mạnh)",
                  "color": "green"
                }
              },
              "type": "value"
            }
          ],
          "unit": "none"
        }
      }
    },
