# ==============================================================================
# HỆ THỐNG ĐẶT PHÒNG KHÁCH SẠN - DOCKER COMPOSE CONFIGURATION
# Học phần: Triển khai và Quản trị Hệ thống Phần mềm (Đề tài 6)
# ==============================================================================

# --- MÔI TRƯỜNG CHUNG ---
NODE_ENV=production
PROJECT_NAME=hotel-booking-system

# --- CỔNG PUBLIC (HOST PORTS) ---
# Nginx Reverse Proxy (Cổng truy cập chính của người dùng)
HTTP_PORT=80
HTTPS_PORT=443
# Nginx Metrics Stub Status
NGINX_STATUS_PORT=8089

# Quản trị cơ sở dữ liệu pgAdmin 4
PGADMIN_PORT=8082

# Hệ thống Giám sát & Logs
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3101
CADVISOR_PORT=8085
NODE_EXPORTER_PORT=9100
NGINX_EXPORTER_PORT=9113
POSTGRES_EXPORTER_PORT=9187

# Cổng PostgreSQL trực tiếp (Dùng cho pgAdmin hoặc DBeaver bên ngoài)
POSTGRES_PORT=5433

# --- CƠ SỞ DỮ LIỆU POSTGRESQL ---
POSTGRES_DB=hotel_booking_db
POSTGRES_USER=hotel_admin
POSTGRES_PASSWORD=HotelSecurePassword2026!
POSTGRES_HOST=postgres
POSTGRES_INTERNAL_PORT=5432

# --- CẤU HÌNH BACKEND (NODE.JS + EXPRESS) ---
BACKEND_PORT=5000
JWT_SECRET=super_secret_hotel_jwt_key_2026_kthp_deployment
LOG_LEVEL=info

# --- CẤU HÌNH PGADMIN ---
PGADMIN_DEFAULT_EMAIL=admin@hotel.com
PGADMIN_DEFAULT_PASSWORD=AdminSecure2026!

# --- CẤU HÌNH GRAFANA ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
